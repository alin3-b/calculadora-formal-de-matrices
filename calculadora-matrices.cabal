cabal-version: 3.0
name: calculadora-matrices
version: 0.1.0.0
build-type: Simple

executable calculadora-matrices
    main-is: Main.hs
    other-modules: Calculadora
    hs-source-dirs: .
    default-language: Haskell2010
    ghc-options: -threaded

    build-depends:
        base >=4.19 && <5,
        aeson,
        scotty,
        text,
        containers,
        http-types,
        wai-cors
